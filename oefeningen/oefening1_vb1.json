{
    "$jsonSchema": {
        "title": "product",
        "description": "Record van een AUDIO ALBUM",
        "bsonType": "object",
        "required": ["naam", "type", "beschrijving", "productnummer"],
        "properties": {
            "naam": {"bsonType": "string"},
            "type": {"bsonType": "string"},
            "productnummer": {"bsonType": "string"},
            "beschrijving": {"bsonType": "string"},
            "afmetingen": {
                "bsonType": "object",
                "required":["hoogte","diepte", "breedte"],
                "properties": {
                    "hoogte": {"bsonType": "number"},
                    "diepte": {"bsonType": "number"},
                    "breedte": {"bsonType": "number"}
                }
            },
            "prijs": {
                "bsonType":"object",
                "required":["retail", "listening"],
                "properties":{
                    "retail": {"bsonType":"number"},
                    "listening": {"bsonType":"number"}
                }
            },
            "details":{
                "bsonType": "object",
                "required":["genre", "tracks","title","by"],
                "properties":{
                    "title": {"bsonType": "string"},
                    "by": {"bsonType": "string"},
                    "genre": {
                        "bsonType": "array",
                        "items":{"bsonType": "string"}
                    },
                    "tracks": {
                        "bsonType": "array",
                        "items":{"bsonType": "string"}
                    }
                }
            }
        }
    }
}