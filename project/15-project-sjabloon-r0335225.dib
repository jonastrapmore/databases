(1, 1, 1, 5, NULL, NULL),   -- Esseghem A (5 overwinningen)
(1, 3, 5, 4, NULL, NULL),   -- Dilbeek B (4 overwinningen)
(1, 8, 10, 4, NULL, NULL),  -- Rode A (4 overwinningen)
(1, 6, 8, 4, NULL, NULL),   -- Singel A (4 overwinningen)
(1, 5, 7, 2, NULL, NULL),   -- De Blockskes A (2 overwinningen)
(1, 2, 2, 1, NULL, NULL),  --  Beersel A (1 overwinning)
(10, 15, 17, 9, NULL, NULL),   -- De Vrienden A (9 overwinningen)
(11, 12, 14, 9, NULL, NULL),   -- PC Sparrendal A (9 overwinningen)
(12, 14, 16, 9, NULL, NULL),   -- De Korenbloem A (9 overwinningen)
(13, 13, 15, 9, NULL, NULL),   -- PC Kortrijk A (9 overwinningen)
(14, 11, 13, 9, NULL, NULL);   -- PC Olympia A (9 overwinningen)



--bepalen van de kampioen na de competitie. 
UPDATE petanque.CompetitieDeelname 
SET isKampioen = 1
FROM petanque.CompetitieDeelname cd
INNER JOIN (
    SELECT DISTINCT CompetitieId,
           FIRST_VALUE(PloegId) OVER (PARTITION BY CompetitieId ORDER BY punten DESC, PloegId) AS TopPloegId
    FROM petanque.CompetitieDeelname
    WHERE CompetitieId IN (1,11,12,13,14)  -- Alle Ere 2025-2026
) topploeg ON cd.CompetitieId = topploeg.CompetitieId AND cd.PloegId = topploeg.TopPloegId;

--bepalen van de degradant na de competite.  
UPDATE petanque.CompetitieDeelname 
SET isDegradant = 1
WHERE CompetitieId = 1 
AND PloegId IN (
    SELECT TOP 1 PloegId 
    FROM petanque.CompetitieDeelname 
    WHERE CompetitieId = 1 
    ORDER BY punten ASC
);


--de tabel met alle winnaars van de ere competities vullen. In ons geval Maar 1 record vermits ik mij geconcentreerd heb enkel Vlaams Brabant. 
INSERT INTO petanque.Eindronde (ReeksNiveau, Provincie, winnaarPloegId, Seizoen)
SELECT 
    'Ere' AS ReeksNiveau,
    a.Provincie,
    cd.PloegId AS winnaarPloegId,
    c.Seizoen
FROM petanque.CompetitieDeelname cd
JOIN petanque.Competitie c ON cd.CompetitieId = c.id
JOIN petanque.Afdeling a ON c.AfdelingId = a.id
WHERE cd.isKampioen = 1 
  AND a.ReeksNiveau = 'Ere'
  AND a.niveauType = 'Provinciaal'
  AND NOT EXISTS (
      SELECT 1 FROM petanque.Eindronde e 
      WHERE e.Provincie = a.Provincie 
        AND e.Seizoen = c.Seizoen
  )
  AND c.id IN (1,11,12,13,14);  -- Focus op 2025-2026 Ere; voeg fictieve toe indien data

#!markdown

## SELECT operaties

Geef bij elke thema 5 queries (m.u.v. set-functies - 3 queries)

Let op: Bij elke query hoort een vraag! 

#!markdown

### Thema 1: Select - Where

#!markdown

Vraag 1: Toon alle clubs in Vlaams‑Brabant met minstens 9 terreinen. sorteer op naam van de club

#!sql-SqlServer

-- Query 1
SELECT *
FROM petanque.Club
WHERE provincie = 'Vlaams Brabant'
  AND aantalTerreinen >= 9
order by naam;

#!markdown

Vraag 2: Toon alle actieve teams waarvan de naam eindigt op ' A'.

#!sql-SqlServer

-- Query 2
SELECT *
FROM petanque.ClubTeam
WHERE actief = 1
  AND naam LIKE '% A';

#!markdown

Vraag 3: Toon alle spelers geboren na 1 januari 1990 waarvan de familienaam met V begint.

#!sql-SqlServer

-- Query 3
SELECT 
  id, 
  clubid, 
  naam, 
  voornaam,
  format(CAST(geboortedatum AS DATE), 'yyyy-MM-dd') AS geboortedatum,
  licentieNummer
FROM petanque.Speler
WHERE geboorteDatum > '1990-01-01'
  AND naam LIKE 'V%';

#!markdown

Vraag 4: Geef alle matchen waar de thuisploeg meer dan 6 punten scoorde en de uitploeg minder dan 3.

#!sql-SqlServer

-- Query 4
SELECT
  CompetitieId,
  thuisPloegId,
  uitPloegId,
  speeldag,
  CONVERT(varchar(10), datum, 105)AS DatumFormatted,
  puntenThuis,
  puntenUit
FROM petanque.Match
WHERE puntenThuis > 6
  AND puntenUit < 3;

#!markdown

Vraag 5: Toon alle terreinen die langer zijn dan 11,5m of breder dan 3,8m.

#!sql-SqlServer

-- Query 5
SELECT *
FROM petanque.Terrein
WHERE lengte_cm > 1150
   OR breedte_cm > 380;

#!markdown

### Thema: Scalaire functies

#!markdown

Vraag 1: Toon per speler de volledige naam zoals 'J. Trap en de leeftijd. sorteer op naam

#!sql-SqlServer

-- Query 1
SELECT
    concat(upper(substring(voornaam, 1,1)), '. ', upper(substring(naam,1,1)), lower(substring(naam, 2, len(naam)))) as 'Volledige naam',
    DATEDIFF(YEAR, geboorteDatum, GETDATE())
      - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, geboorteDatum, GETDATE()), geboorteDatum) > GETDATE()
             THEN 1 ELSE 0 END AS Leeftijd
FROM petanque.Speler
order by naam;

#!markdown

Vraag 2: Toon voor elke club de provincie zonder (-) en het jaar van oprichting + geef aan of een gebouw goedgekeurd of afgekeurd is. Indien geen licentie geef dan 'nonactief' weer. 

#!sql-SqlServer

-- Query 2
SELECT
    naam,
    LOWER(provincie)      AS provincie,
    YEAR(oprichtingsDatum) AS oprichtingsJaar,
    case
        when gebouwGoedgekeurd = 0 then 'afgekeurd'
        else 'goedgekeurd'
    end as 'Goedgekeurd/Afgekeurd',
    case
        when licentieNummer is null then 'nonactief'
        else 'acftief'
    end as 'actief/nonactief'
FROM petanque.Club;

#!markdown

Vraag 3: Toon alle competities met het seizoen opgesplitst in begin‑ en eindjaar. Sorteer aflopend van jaar. 

#!sql-SqlServer

-- Query 3 
SELECT distinct
    Seizoen,
    LEFT(Seizoen, 4)  AS BeginJaar,
    RIGHT(Seizoen, 4) AS EindJaar
FROM petanque.Competitie
order by seizoen desc;

#!markdown

Vraag 4: Toon per match datum, weekdag (naam) en startuur in HH:MM‑formaat. Geef ook de uitploeg en thuis ploeg

#!sql-SqlServer

-- Query 4 
SELECT
    DATENAME(WEEKDAY, datum)                         AS Weekdag,
    CONVERT(varchar(10), datum, 105)                 AS DatumFormatted,   -- 05-10-2025
    FORMAT(CAST(startUur AS datetime), 'HH:mm')     AS StartUurFormatted, -- 14:00
    cHome.naam as Thuisploeg,
    cUit.naam as Uitploeg
FROM petanque.Match as m
    join petanque.clubteam as cHome on cHome.ploegid = m.thuisploegid
    join petanque.clubteam as cUit on cUit.ploegid = m.uitploegid;

#!markdown

Vraag 5: Toon per ploeg een samengestelde tekst hoeveel aantal spelers ze hebben.

#!sql-SqlServer

-- Query 5 
SELECT 
    ct.naam as Naam,
    c.provincie as Provincie,
    ct.aantalSpelers as '#spelers',
    concat(ct.naam, ' (', c.provincie, ') heeft ', ct.aantalSpelers, ' spelers.') as Beschrijving
FROM petanque.ClubTeam ct
JOIN petanque.Club c ON c.id = ct.ClubId
order by aantalspelers, provincie, naam;

#!markdown

### Thema: Joins deel 1 + deel 2 

Gebruik minstens een keer een inner, left en right  join.

#!markdown

Vraag 1: toon alle spelers met hun clubnaam.

#!sql-SqlServer

-- Query1
SELECT
    s.voornaam as 'Voornaam',
    s.naam as 'Familienaam',
    c.naam as 'Club Naam'
FROM petanque.speler AS s
    JOIN petanque.club AS c ON s.ClubId = c.id
ORDER BY 'Club Naam';

#!markdown

Vraag 2: toon alle wedstrijden met namen van thuis‑ en uitploeg en de club van de thuisploeg.

#!sql-SqlServer

-- Query 2

SELECT
    CONVERT(varchar(10), m.datum, 105)  AS DatumFormatted,
    ctHome.naam                         AS ThuisPloeg,
    ctAway.naam                         AS UitPloeg,
    c.naam                              AS ThuisClub
FROM petanque.Match as m
    JOIN petanque.ClubTeam ctHome ON m.thuisPloegId = ctHome.ploegId
    JOIN petanque.ClubTeam ctAway ON m.uitPloegId = ctAway.ploegId
    JOIN petanque.Club c ON ctHome.ClubId = c.id;

#!markdown

Vraag 3: toon alle clubs met hun teams. En toon of een team al dan niet de eindronde heeft gespeeld door het seizoen te laten zien wanneer ze dat gespeeld hebben. 

#!sql-SqlServer

-- Query 3 
SELECT 
    c.naam  AS ClubNaam,
    ct.naam AS TeamNaam,
    er.seizoen AS EindeRondeGespeeld
FROM petanque.ClubTeam ct
LEFT JOIN petanque.Club c ON ct.ClubId = c.id
LEFT JOIN petanque.Eindronde er ON ct.ploegId = er.winnaarPloegId
GROUP BY ct.ploegId, ct.naam, c.naam, er.Seizoen
ORDER BY ClubNaam, TeamNaam;

#!markdown

Vraag 4: Toon alle ploegen die deelnemen aan de competitie Vlaams Brabant Ere 2025-2026 met clubnaam, ploegnaam en behaalde punten.

#!sql-SqlServer

-- Query 4 
SELECT 
    c.naam  AS clubNaam,
    ct.naam AS ploegNaam,
    cd.punten
FROM petanque.CompetitieDeelname cd
JOIN petanque.Competitie comp   ON comp.id = cd.CompetitieId
JOIN petanque.Afdeling a        ON a.id = comp.AfdelingId
JOIN petanque.ClubTeam ct       ON ct.ploegId = cd.PloegId
JOIN petanque.Club c            ON c.id = cd.ClubId
WHERE a.ReeksNiveau = 'Ere'
  AND a.Provincie   = 'Vlaams Brabant'
  AND comp.Seizoen  = '2025-2026';

#!markdown

Vraag 5: Schrijf een query die voor elke match in de provinciale Ere‑competitie van Vlaams‑Brabant in het seizoen 2025‑2026 de volgende gegevens toont: speeldag, datum (dd‑MM‑yyyy), weekdag, startuur (HH:mm), naam van de thuisclub, provincie waarin de afdeling gespeeld wordt, het aantal terreinen van de thuisclub, het volledige adres waar er gespeeld wordt, naam van de thuisploeg, naam van de uitclub, naam van de uitploeg, het aantal huidige spelers in de thuisploeg, het aantal huidige spelers in de uitploeg en ten slotte de gescoorde punten van thuis‑ en uitploeg.

#!sql-SqlServer

-- Query 5 
SELECT
    m.speeldag,
    CONVERT(varchar(10), m.datum, 105)                 AS Datum,              
    DATENAME(WEEKDAY, m.datum)                         AS Weekdag,            
    FORMAT(CAST(m.startUur AS datetime), 'HH:mm')      AS StartUur,          

    -- thuisclub / locatie
    cHome.naam                                         AS ThuisClub,
    a.Provincie                                        AS AfdelingProvincie,
    cHome.aantalTerreinen                              AS ThuisAantalTerreinen,
    CONCAT(cHome.adres, ' ', cHome.huisnummer, ', ',
           cHome.postcode, ' ', cHome.gemeente)        AS Speellocatie,      

    ctHome.naam                                        AS ThuisPloeg,
    cAway.naam                                         AS UitClub,
    ctAway.naam                                        AS UitPloeg,

    tsHome.AantalSpelers                               AS ThuisAantalSpelers,
    tsAway.AantalSpelers                               AS UitAantalSpelers,

    m.puntenThuis,
    m.puntenUit
FROM petanque.Match m
JOIN petanque.Competitie comp
    ON m.CompetitieId = comp.id
JOIN petanque.Afdeling a
    ON comp.AfdelingId = a.id
JOIN petanque.ClubTeam ctHome
    ON m.thuisPloegId = ctHome.ploegId
JOIN petanque.Club cHome
    ON ctHome.ClubId = cHome.id
JOIN petanque.ClubTeam ctAway
    ON m.uitPloegId = ctAway.ploegId
JOIN petanque.Club cAway
    ON ctAway.ClubId = cAway.id
LEFT JOIN (
    SELECT PloegId, COUNT(*) AS AantalSpelers
    FROM petanque.TeamSpeler
    WHERE totDatum IS NULL
    GROUP BY PloegId
) tsHome
    ON tsHome.PloegId = ctHome.ploegId
LEFT JOIN (
    SELECT PloegId, COUNT(*) AS AantalSpelers
    FROM petanque.TeamSpeler
    WHERE totDatum IS NULL
    GROUP BY PloegId
) tsAway
    ON tsAway.PloegId = ctAway.ploegId
WHERE
    a.ReeksNiveau = 'Ere'
    AND a.Provincie = 'Vlaams Brabant'
    AND comp.Seizoen = '2025-2026';

#!markdown

### Thema: Subqueries

#!markdown

Vraag 1: Toon alle spelers die in dezelfde club zitten als 'TRAP' 'Jonas'

#!sql-SqlServer

-- Query1
SELECT
    ClubId,
    naam,
    voornaam,
    CONVERT(varchar(10), geboorteDatum, 105) AS GeboorteDatumFormatted,
    licentieNummer
FROM petanque.Speler
WHERE ClubId = (
    SELECT ClubId
    FROM petanque.Speler
    WHERE naam = 'TRAP'
      AND voornaam = 'Jonas'
);

#!markdown

Vraag 2: Toon clubs waarvan het aantal terreinen groter is dan het gemiddelde over alle clubs.

#!sql-SqlServer

-- Query2 
SELECT 
    naam,
    CONCAT(adres, ' ', huisnummer, ', ', postcode, ' ', gemeente) AS VolledigAdres,
    provincie,
    aantalTerreinen
FROM petanque.Club
WHERE aantalTerreinen > (
    SELECT AVG(aantalTerreinen)
    FROM petanque.Club
);

#!markdown

Vraag 3: Toon alle ploegen die deelnemen aan de competitie waarin Kerkom A kampioen werd. Geef ook hun clubnaam weer. Kerkom A moet je niet meer weegeven vermits die al in de vraag staat

#!sql-SqlServer

-- Query3 
SELECT 
    ct.ploegId,
    c.naam      AS ClubNaam,
    ct.naam     AS PloegNaam
FROM petanque.ClubTeam ct
JOIN petanque.Club c
    ON ct.ClubId = c.id
WHERE ct.ploegId IN (
    SELECT PloegId
    FROM petanque.CompetitieDeelname 
    WHERE CompetitieId = (
        SELECT CompetitieId
        FROM petanque.CompetitieDeelname cd
        JOIN petanque.ClubTeam ct2 
            ON cd.PloegId = ct2.ploegId
        WHERE ct2.naam = 'Kerkom A'
          AND cd.isKampioen = 1
    )
)
   AND ct.ploegID <> (
        select ploegid from petanque.ClubTeam  WHERE naam = 'Kerkom A'
   );

#!markdown

Vraag 4: Toon alle spelers die al minstens 3 jaar lid zijn van hun huidige club. Geef naam, voornaam, clubnaam en inschrijvingsduur in jaren weer.

#!sql-SqlServer

-- Query4 
SELECT 
    s.naam,
    s.voornaam,
    c.naam AS ClubNaam,
    d.JarenLid
FROM petanque.Speler s
JOIN (
    SELECT 
        ts.SpelerId,
        DATEDIFF(YEAR, MIN(ts.vanafDatum), GETDATE()) AS JarenLid
    FROM petanque.TeamSpeler ts
    GROUP BY ts.SpelerId
    HAVING DATEDIFF(YEAR, MIN(ts.vanafDatum), GETDATE()) >= 3
) d ON s.id = d.SpelerId
JOIN petanque.TeamSpeler ts ON s.id = ts.SpelerId
JOIN petanque.ClubTeam ct ON ts.PloegId = ct.ploegId
JOIN petanque.Club c ON ct.ClubId = c.id
order by s.naam;

#!markdown

Vraag 5: Toon de top 3 ploegen qua punten in de competitie Vlaams Brabant Ere 2025-2026 via een subquery

#!sql-SqlServer

-- Query5 
SELECT TOP 3
    ct.naam AS PloegNaam,
    c.naam  AS ClubNaam,
    cd.punten
FROM petanque.CompetitieDeelname cd
JOIN petanque.ClubTeam ct
    ON cd.PloegId = ct.ploegId
JOIN petanque.Club c
    ON cd.ClubId = c.id
WHERE cd.CompetitieId = (
    SELECT comp.id
    FROM petanque.Competitie comp
    JOIN petanque.Afdeling a
        ON comp.AfdelingId = a.id
    WHERE a.ReeksNiveau = 'Ere'
      AND a.Provincie   = 'Vlaams Brabant'
      AND comp.Seizoen  = '2025-2026'
)
ORDER BY cd.punten DESC,       -- eerst meeste punten
         ct.naam ASC;          -- bij gelijke punten alfabetisch

#!markdown

### Thema: Set-functies

#!markdown

Vraag 1: Toon alle clubs of ze een licentie hebben (“Met licentie”) of niet (“Zonder licentie”)

#!sql-SqlServer

-- Query1 
SELECT 
    naam,
    provincie,
    'Met licentie' AS LicentieStatus
FROM petanque.Club
WHERE licentieNummer IS NOT NULL

UNION ALL

SELECT 
    naam,
    provincie,
    'Zonder licentie' AS LicentieStatus
FROM petanque.Club
WHERE licentieNummer IS NULL;

#!markdown

Vraag 2: Toon een lijst van alle namen van clubs en alle namen van ploegen onder elkaar in één kolom Naam. Vermeld in een tweede kolom of het om een club of een ploeg gaat.

#!sql-SqlServer

-- Query2 
SELECT 
    naam          AS Naam,
    'Club'        AS Type
FROM petanque.Club

UNION ALL

SELECT 
    naam          AS Naam,
    'Ploeg'       AS Type
FROM petanque.ClubTeam
order by naam;

#!markdown

Vraag 3: toon alle ploegen die minstens 3 matchen thuis gewonnen hebben en geen kampioen gespeeld zijn

#!sql-SqlServer

-- Query3 
SELECT 
    ct.naam AS PloegNaam,
    COUNT(*) AS AantalThuisOverwinningen
FROM petanque.Match m
JOIN petanque.ClubTeam ct
    ON m.thuisPloegId = ct.ploegId
WHERE m.CompetitieId = 1              
  AND m.puntenThuis > m.puntenUit     
  AND ct.ploegId NOT IN (             
        SELECT PloegId
        FROM petanque.CompetitieDeelname
        WHERE CompetitieId = 1
          AND isKampioen = 1
      )
GROUP BY ct.naam
HAVING COUNT(*) >= 3;

#!markdown

### Thema: Group by

#!markdown

Vraag 1: Bereken voor competitie 1 de puntenstand per ploeg (1 punt per gewonnen match), enkel op basis van de tabel Match.

#!sql-SqlServer

-- Query1 
SELECT 
    ct.naam AS ploegNaam,
    SUM(
        CASE 
            WHEN m.thuisPloegId = ct.ploegId AND m.puntenThuis > m.puntenUit THEN 1
            WHEN m.uitPloegId   = ct.ploegId AND m.puntenUit   > m.puntenThuis THEN 1
            ELSE 0
        END
    ) AS punten
FROM petanque.ClubTeam ct
JOIN petanque.Match m
     ON m.thuisPloegId = ct.ploegId 
     OR m.uitPloegId   = ct.ploegId
WHERE m.CompetitieId = 1
GROUP BY ct.naam
ORDER BY punten DESC;

#!markdown

Vraag 2: Toon per ploeg het totaal aantal gescoorde punten (thuis + uit).

#!sql-SqlServer

-- Query2  
SELECT 
    ct.naam AS PloegNaam,
    SUM(CASE WHEN m.thuisPloegId = ct.ploegId THEN m.puntenThuis ELSE 0 END +
        CASE WHEN m.uitPloegId   = ct.ploegId THEN m.puntenUit   ELSE 0 END) AS TotaalPunten
FROM petanque.ClubTeam ct
JOIN petanque.Match m
    ON m.CompetitieId = 1
   AND (m.thuisPloegId = ct.ploegId OR m.uitPloegId = ct.ploegId)
GROUP BY ct.naam
ORDER BY TotaalPunten DESC;

#!markdown

Vraag 3:  Bereken per ploeg in Vlaams Brabant Ere 2025-2026 de gemiddelde leeftijd van de spelers die nu in dat team zitten.

#!sql-SqlServer

-- Query3
SELECT 
    ct.naam AS ploegNaam,
    AVG(DATEDIFF(YEAR, s.geboorteDatum, GETDATE())) AS gemiddeldeLeeftijd
FROM petanque.CompetitieDeelname cd
JOIN petanque.Competitie comp ON comp.id = cd.CompetitieId
JOIN petanque.Afdeling a      ON a.id = comp.AfdelingId
JOIN petanque.ClubTeam ct     ON ct.ploegId = cd.PloegId
JOIN petanque.TeamSpeler ts   ON ts.PloegId = ct.ploegId AND ts.totDatum IS NULL
JOIN petanque.Speler s        ON s.id = ts.SpelerId
WHERE a.ReeksNiveau = 'Ere'
  AND a.Provincie   = 'Vlaams Brabant'
  AND comp.Seizoen  = '2025-2026'
GROUP BY ct.naam
ORDER BY gemiddeldeLeeftijd DESC;

#!markdown

Vraag 4: Toon per club het aantal ploegen en het totaal aantal spelers dat momenteel voor die club uitkomt. Sorteer aflopend op aantal spelers.

#!sql-SqlServer

-- Query4 
SELECT 
    c.naam AS ClubNaam,
    COUNT(DISTINCT ct.ploegId) AS AantalPloegen,
    SUM(CASE WHEN ts.id IS NULL THEN 0 ELSE 1 END) AS AantalActieveSpelers
FROM petanque.Club c
LEFT JOIN petanque.ClubTeam ct
    ON c.id = ct.ClubId
LEFT JOIN petanque.TeamSpeler ts
    ON ct.ploegId = ts.PloegId
   AND ts.totDatum IS NULL
GROUP BY c.naam
ORDER BY AantalActieveSpelers DESC;

#!markdown

Vraag 5: Toon per thuisploeg in de competitie “Vlaams Brabant Ere 2025‑2026” het aantal gespeelde thuiswedstrijden, het totaal aantal thuispunten en het gemiddelde aantal thuispunten per mat

#!sql-SqlServer

-- Query5 
SELECT
    ctHome.naam                                 AS ThuisPloeg,
    COUNT(*)                                    AS AantalThuisMatchen,
    SUM(m.puntenThuis)                          AS TotaalThuisPunten,
    CAST(ROUND(AVG(m.puntenThuis * 1.0), 2) AS decimal(10,2)) AS GemThuisPunten
FROM petanque.Match m
JOIN petanque.Competitie comp
    ON m.CompetitieId = comp.id
JOIN petanque.Afdeling a
    ON comp.AfdelingId = a.id
JOIN petanque.ClubTeam ctHome
    ON m.thuisPloegId = ctHome.ploegId
WHERE a.ReeksNiveau = 'Ere'
  AND a.Provincie   = 'Vlaams Brabant'
  AND comp.Seizoen  = '2025-2026'
GROUP BY ctHome.naam
ORDER BY GemThuisPunten DESC;
